@PAD: hvvcas-spec-v1
@GCDE: gaplune.policy.v1
schema_id: gaplune.hvvcas.v1
format: gaplune
json: prohibited
crate: gap-285-p14-readme-tree
note: Durable HVVCAS is GAPLUNE. Do not persist YAML. New crate only.
ticket: GAP-285-P14

component:
  name: vendor_folder_as_gap
  domain: admit
  component_type: library
  intent: Detect GAP README lines that name vendor-tree folders as GAP repo files
  input:
    name: src
    type: String
  output:
    name: claims
    type: bool

component:
  name: root_schema_named
  domain: admit
  component_type: library
  intent: Require GAP meta schema v1 v1.2 and v1.3 named at repo root
  input:
    name: src
    type: String
  output:
    name: named
    type: bool

component:
  name: vendor_url_named
  domain: admit
  component_type: library
  intent: Require full Gitea http URLs for vendor compile reference coding-gov and FILE-FORMAT
  input:
    name: src
    type: String
  output:
    name: named
    type: bool

component:
  name: helper_package_named
  domain: admit
  component_type: library
  intent: Require Helper packages sit on GAP plus crate and p14 helper folders
  input:
    name: src
    type: String
  output:
    name: named
    type: bool

component:
  name: scan_readme_tree
  domain: admit
  component_type: service
  intent: Collect-all GAP README tree truth. Closed walls name vendor folders missing root schema missing vendor URL and missing helper package. Write DENY on miss.
  input:
    name: readme
    type: String
  output:
    name: result
    type: String
