@PAD: hvvcas-spec-v1
@GCDE: gaplune.policy.v1
schema_id: gaplune.hvvcas.v1
format: gaplune
json: prohibited
crate: gap-285-p9-vendor-readme-one-law
note: Durable HVVCAS is GAPLUNE. Do not persist YAML. New crate only.
ticket: GAP-285-P9

component:
  name: documentary_rank_ring
  domain: admit
  component_type: library
  intent: Detect vendor README or FILE-FORMAT text that teaches trust_ring as a documentary label or rank use that warns then denies
  input:
    name: src
    type: String
  output:
    name: teaches
    type: bool

component:
  name: one_law_presence_deny
  domain: admit
  component_type: library
  intent: Require the one-law sentence Presence of trust_ring is Deny and Who-may is agent_may
  input:
    name: src
    type: String
  output:
    name: has_one_law
    type: bool

component:
  name: live_path_named
  domain: admit
  component_type: library
  intent: Require seal freeze-at-seal 1000 ms collect-all Admit Apply agent_may and sha256-structure
  input:
    name: src
    type: String
  output:
    name: named
    type: bool

component:
  name: gap_source_ext
  domain: admit
  component_type: library
  intent: Require Keep .gap as GAP source
  input:
    name: src
    type: String
  output:
    name: keeps_gap
    type: bool

component:
  name: scan_vendor_readme_one_law
  domain: admit
  component_type: service
  intent: Collect-all vendor README one-law after schema law. Closed walls name documentary rank rings missing one-law missing live path and missing .gap source. Write DENY on miss.
  input:
    name: readme
    type: String
  output:
    name: result
    type: String

component:
  name: scan_file_format_one_law
  domain: admit
  component_type: service
  intent: Collect-all FILE-FORMAT one-law after schema law. Closed walls name documentary rank rings missing one-law missing live path and missing .gap source. Write DENY on miss.
  input:
    name: file_format
    type: String
  output:
    name: result
    type: String
