@PAD: hvvcas-spec-v1
@GCDE: gaplune.policy.v1
schema_id: gaplune.hvvcas.v1
format: gaplune
json: prohibited
crate: gap-snapshot-hygiene
note: Durable HVVCAS is GAPLUNE. Do not persist YAML. New crate only.
ticket: GAP-285-P2

component:
  name: structural_cli_line
  domain: admit
  component_type: library
  intent: Detect a README line that is a structural compile or structural run CLI command
  input:
    name: line
    type: String
  output:
    name: is_cli
    type: bool

component:
  name: required_shipped_bins
  domain: admit
  component_type: library
  intent: Name the shipped crate binaries gap-schema-profile-v13 gap-closed-wall-deny gap-proof-live-bundle-mode and gap-snapshot-hygiene
  input:
    name: unused
    type: String
  output:
    name: bins
    type: VecString

component:
  name: required_cargo_run_lines
  domain: admit
  component_type: library
  intent: Name cargo run manifest-path commands for each shipped crate binary
  input:
    name: unused
    type: String
  output:
    name: lines
    type: VecString

component:
  name: scan_readme_snapshot_hygiene
  domain: admit
  component_type: service
  intent: Collect-all snapshot hygiene. Closed walls name missing binaries and structural CLI commands. Write DENY on miss.
  input:
    name: readme
    type: String
  output:
    name: result
    type: HygieneResult
